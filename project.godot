; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="Lattice Ui"
run/main_scene="res://Main.tscn"
config/features=PackedStringArray("4.6", "Mobile")
run/low_processor_mode=true
boot_splash/bg_color=Color(0, 0, 0, 1)
boot_splash/image="res://assets/logo_transparent.png"
config/icon="res://icon.png"

[autoload]

Settings="*res://scripts/Settings.gd"
ColorPalette="*res://scripts/ColorPalette.gd"
AnimationHelper="*res://scripts/AnimationHelper.gd"

[display]

window/size/viewport_width=1080
window/size/viewport_height=2400
window/size/mode=3
window/size/initial_position_type=0
window/size/resizable=false
window/size/borderless=true
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/per_pixel_transparency/allowed=true
window/handheld/orientation=1

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
window/frame_pacing/android/enable_frame_pacing=false
window/frame_pacing/android/swappy_mode=0
